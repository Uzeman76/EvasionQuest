lumn index="1" value="35"/><column index="2" value="39"/><column index="3" value="88"/><column index="4" value="43"/><column index="5" value="35"/><column index="6" value="35"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Question" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="300"/><column index="3" value="59"/><column index="4" value="90"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="Salle" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="199"/><column index="3" value="39"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="correspond" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="35"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="reponse" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="35"/><column index="2" value="300"/><column index="3" value="55"/><column index="4" value="35"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">PRAGMA foreign_keys = ON;

CREATE TABLE Question(
   id INTEGER,
   question TEXT NOT NULL,
   est_boss NUMERIC NOT NULL,
   type_question TEXT NOT NULL,
   PRIMARY KEY(id),
   UNIQUE(question)
);

CREATE TABLE Salle(
   id INTEGER,
   nom TEXT NOT NULL,
   ordre INTEGER NOT NULL,
   PRIMARY KEY(id),
   UNIQUE(nom)
);

CREATE TABLE Gardien(
   id INTEGER,
   nom_gardien TEXT NOT NULL,
   vies INTEGER NOT NULL,
   temps_limite INTEGER NOT NULL,
   id_1 INTEGER NOT NULL,
   PRIMARY KEY(id),
   UNIQUE(id_1),
   UNIQUE(nom_gardien),
   FOREIGN KEY(id_1) REFERENCES Salle(id)
);

CREATE TABLE Joueur(
   id INTEGER,
   pseudo TEXT NOT NULL,
   PRIMARY KEY(id),
   UNIQUE(pseudo)
);

CREATE TABLE Partie(
   id INTEGER,
   score INTEGER,
   date_creation TEXT NOT NULL,
   statut TEXT NOT NULL,
   id_1 INTEGER NOT NULL,
   id_2 INTEGER NOT NULL,
   PRIMARY KEY(id),
   FOREIGN KEY(id_1) REFERENCES Salle(id),
   FOREIGN KEY(id_2) REFERENCES Joueur(id)
);

CREATE TABLE reponse(
   id INTEGER,
   texte TEXT NOT NULL,
   est_vrai NUMERIC NOT NULL,
   id_1 INTEGER NOT NULL,
   PRIMARY KEY(id),
   FOREIGN KEY(id_1) REFERENCES Question(id)
);

CREATE TABLE correspond(
   id INTEGER,
   id_1 INTEGER,
   PRIMARY KEY(id, id_1),
   FOREIGN KEY(id) REFERENCES Question(id),
   FOREIGN KEY(id_1) REFERENCES Salle(id)
);
</sql><sql name="SQL 2*">PRAGMA foreign_keys = ON;

DELETE FROM correspond;
DELETE FROM reponse;
DELETE FROM Partie;
DELETE FROM Gardien;
DELETE FROM Question;
DELETE FROM Salle;
DELETE FROM Joueur;

-- Remettre les compteurs d'ID à 0
DELETE FROM sqlite_sequence;</sql><current_tab id="1"/></tab_sql></sqlb_project>
